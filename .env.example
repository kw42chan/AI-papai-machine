# OPENROUTER_API_KEY: Required for card OCR (the 掃描卡牌 button).
# Create one at https://openrouter.ai/keys and put it in your own .env file, never in the code.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: Any OpenRouter model that accepts images. Optional.
# Defaults to google/gemini-2.5-flash when left out. Some providers (OpenAI, Anthropic, Google) refuse
# requests from certain regions; if you get a "terms of service" error, pick a Qwen vision model.
OPENROUTER_MODEL="qwen/qwen3-vl-32b-instruct"
